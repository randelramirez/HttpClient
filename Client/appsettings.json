{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Information"
    },
    "Console": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },
  "ApiSettings": {
    "BaseUrl": "https://localhost:44354/",
    "TimeoutSeconds": 30,
    "MaxRetries": 3,
    "CircuitBreakerThreshold": 5,
    "CircuitBreakerTimeoutMinutes": 1,
    "MaxConnectionsPerServer": 10,
    "EnableCompression": true,
    "EnableLogging": true
  },
  "HttpClientSettings": {
    "ContactsClient": {
      "BaseAddress": "https://localhost:44354/",
      "Timeout": "00:00:30",
      "DefaultHeaders": {
        "User-Agent": "HttpClientDemo/1.0 (.NET 9.0)",
        "Accept": "application/json",
        "X-Client-Version": "1.0.0"
      }
    },
    "ProductionClient": {
      "BaseAddress": "https://localhost:44354/",
      "Timeout": "00:01:40",
      "MaxConnectionsPerServer": 10,
      "EnableRetry": true,
      "EnableCircuitBreaker": true,
      "EnableLogging": true
    },
    "PerformanceClient": {
      "BaseAddress": "https://localhost:44354/",
      "Timeout": "00:00:15",
      "MaxConnectionsPerServer": 50,
      "EnableCompression": true,
      "DisableProxy": true
    }
  },
  "ResilienceSettings": {
    "RetryPolicy": {
      "MaxRetries": 3,
      "BackoffType": "Exponential",
      "BaseDelaySeconds": 1,
      "MaxDelaySeconds": 30
    },
    "CircuitBreaker": {
      "FailureThreshold": 5,
      "TimeoutMinutes": 1,
      "SamplingDurationSeconds": 10
    },
    "Timeout": {
      "DefaultTimeoutSeconds": 30,
      "CriticalOperationTimeoutSeconds": 10,
      "BulkOperationTimeoutSeconds": 120
    }
  },
  "PerformanceSettings": {
    "ConnectionPooling": {
      "MaxConnectionsPerServer": 50,
      "ConnectionLeaseTimeoutSeconds": 60,
      "PooledConnectionLifetimeMinutes": 5
    },
    "Compression": {
      "EnableGzip": true,
      "EnableDeflate": true,
      "CompressionThresholdBytes": 1024
    },
    "Concurrency": {
      "MaxConcurrentRequests": 10,
      "ThrottleDelayMilliseconds": 100
    }
  }
}